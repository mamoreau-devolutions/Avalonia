<Project>

  <!--
    The rustolonia subtree hosts the Rust bindings projects while they still build
    against the in-repo Avalonia source. It mirrors src/Directory.Build.props so the
    shared version, signing and analyzer imports keep applying (InternalsVisibleTo
    into Avalonia.Controls relies on the host being signed with avalonia.snk). When
    this directory becomes the root of its own repository, replace these imports
    with a standalone build configuration.
  -->
  <Import Project="..\Directory.Build.props" />
  <Import Project="..\build\SharedVersion.props" />
  <Import Project="..\build\NetAnalyzers.props" />
  <Import Project="..\build\ExternalConsumers.props" />

  <!--
    The repo-root chain escalates warnings to errors in Release. The generated
    projection sources emit a set of benign CS86xx nullable warnings, so the
    subtree keeps warnings non-fatal to match the standalone rustolonia repository
    build, whose props never set TreatWarningsAsErrors.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
