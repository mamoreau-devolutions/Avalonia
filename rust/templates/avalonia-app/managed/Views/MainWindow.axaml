<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Avalonia.Rust.Consumer.Generated"
        x:Class="Avalonia.Rust.Consumer.Views.MainWindow"
        x:DataType="vm:MainViewModelAdapter"
        Width="480" Height="160" Title="Avalonia Rust consumer">
  <TextBlock Margin="24" FontSize="20" Text="{Binding Title}" />
</Window>
